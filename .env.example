# MySQL connection string — for production point this at a hosted MySQL
# (PlanetScale, Railway, Aiven, etc.)
DATABASE_URL="mysql://zeon:zeonpass@localhost:3306/zeon_crm"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Base URL of the deployed app (Vercel sets this automatically via AUTH_TRUST_HOST)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Initial admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_PASSWORD="ChangeMe!123"

# Your business details, printed on proposals (and invoices from day 4).
# AUTH_URL above is also used to build the public proposal share links.
COMPANY_NAME="Zeon Studio"
COMPANY_EMAIL="hello@example.com"
COMPANY_PHONE=""
COMPANY_ADDRESS=""
