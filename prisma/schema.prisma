generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum LabelType {
  WORK
  MOBILE
  HOME
  OTHER
}

enum AddressType {
  BILLING
  SHIPPING
  OFFICE
  OTHER
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ProjectStage {
  QUOTED
  CONFIRMED
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(MEMBER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  resetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Customer {
  id        String         @id @default(cuid())
  name      String
  industry  String?
  website   String?
  notes     String?        @db.Text
  status    CustomerStatus @default(LEAD)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  contacts  Contact[]
  addresses Address[]
  projects  Project[]
  proposals Proposal[]

  @@index([name])
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  firstName  String
  lastName   String
  title      String?
  isPrimary  Boolean  @default(false)
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phones   ContactPhone[]
  emails   ContactEmail[]

  @@index([customerId])
}

model ContactPhone {
  id        String    @id @default(cuid())
  contactId String
  label     LabelType @default(WORK)
  number    String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model ContactEmail {
  id        String    @id @default(cuid())
  contactId String
  label     LabelType @default(WORK)
  email     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model Address {
  id         String      @id @default(cuid())
  customerId String
  type       AddressType @default(OFFICE)
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Project {
  id          String       @id @default(cuid())
  customerId  String
  name        String
  description String?      @db.Text
  stage       ProjectStage @default(QUOTED)
  price       Decimal?     @db.Decimal(12, 2)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tasks    ProjectTask[]

  @@index([customerId])
  @@index([stage])
}

model Proposal {
  id         String         @id @default(cuid())
  number     String         @unique
  customerId String
  title      String
  summary    String?        @db.Text
  status     ProposalStatus @default(DRAFT)
  issueDate  DateTime       @default(now())
  validUntil DateTime?
  taxRate    Decimal        @default(0) @db.Decimal(5, 2)
  terms      String?        @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Sharing — the token is the client's only credential, so it is issued when the
  // proposal is sent and cleared when it goes back to draft.
  shareToken      String?   @unique
  sentAt          DateTime?
  respondedAt     DateTime?
  respondedByName String?
  declineNote     String?   @db.Text

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    ProposalItem[]

  @@index([customerId])
  @@index([status])
}

model ProposalItem {
  id          String  @id @default(cuid())
  proposalId  String
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  position    Int     @default(0)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model ProjectTask {
  id        String   @id @default(cuid())
  projectId String
  title     String
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
