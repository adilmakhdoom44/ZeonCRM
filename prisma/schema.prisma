generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum LabelType {
  WORK
  MOBILE
  HOME
  OTHER
}

enum AddressType {
  BILLING
  SHIPPING
  OFFICE
  OTHER
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  CHEQUE
  OTHER
}

enum ExpenseCategory {
  SUBCONTRACTOR
  SOFTWARE
  HARDWARE
  TRAVEL
  STOCK_ASSETS
  OTHER
}

enum Cadence {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
}

enum ProjectStage {
  QUOTED
  CONFIRMED
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(MEMBER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  resetTokens PasswordResetToken[]
  activities  Activity[]
  savedViews  SavedView[]
  customers   Customer[]
  projects    Project[]
  auditLogs   AuditLog[]
}

/**
 * Who did what. Written alongside the change itself, never edited or deleted —
 * an audit trail you can amend is not one. The actor is kept as a name as well
 * as a relation so the record still reads correctly after someone leaves and
 * their account is removed.
 */
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actorName  String
  action     String
  entity     String
  entityId   String
  summary    String
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

/**
 * Your own business details, printed on every proposal and invoice. A single row
 * — the app serves one company — pinned to a fixed id so it can be upserted
 * without first asking whether it exists.
 */
model CompanySettings {
  id        String   @id @default("default")
  name      String   @default("Zeon Studio")
  email     String?
  phone     String?
  address   String?
  currency  String   @default("USD")
  taxRate   Decimal  @default(0) @db.Decimal(5, 2)
  updatedAt DateTime @updatedAt
}

/**
 * One row per attempt at something worth throttling. Kept in the database
 * rather than in memory on purpose: on Vercel each request may hit a different
 * instance, and a limiter that forgets between instances is not a limiter.
 * Rows are pruned as they expire, so the table stays small.
 */
model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

/** A label you can hang on any number of accounts and then filter by. */
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("slate")
  createdAt DateTime @default(now())

  customers Customer[]
}

/**
 * A filter combination someone wants back later. The query string is stored
 * verbatim rather than as columns, so adding a new filter to the customer list
 * never needs a migration here.
 */
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Customer {
  id        String         @id @default(cuid())
  name      String
  industry  String?
  website   String?
  notes     String?        @db.Text
  status    CustomerStatus @default(LEAD)
  // Who owns the relationship. Nullable: an unowned account is a real state,
  // and losing the owner must not take the account with it.
  ownerId   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  contacts  Contact[]
  addresses Address[]
  projects  Project[]
  proposals  Proposal[]
  invoices   Invoice[]
  activities Activity[]
  tags       Tag[]
  recurring  RecurringInvoice[]
  expenses   Expense[]

  @@index([name])
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  firstName  String
  lastName   String
  title      String?
  isPrimary  Boolean  @default(false)
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phones     ContactPhone[]
  emails     ContactEmail[]
  activities Activity[]

  @@index([customerId])
}

model ContactPhone {
  id        String    @id @default(cuid())
  contactId String
  label     LabelType @default(WORK)
  number    String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model ContactEmail {
  id        String    @id @default(cuid())
  contactId String
  label     LabelType @default(WORK)
  email     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model Address {
  id         String      @id @default(cuid())
  customerId String
  type       AddressType @default(OFFICE)
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Project {
  id          String       @id @default(cuid())
  customerId  String
  name        String
  description String?      @db.Text
  stage       ProjectStage @default(QUOTED)
  ownerId     String?
  price       Decimal?     @db.Decimal(12, 2)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  owner      User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  tasks      ProjectTask[]
  proposal   Proposal?
  invoices   Invoice[]
  activities Activity[]
  expenses   Expense[]

  @@index([customerId])
  @@index([stage])
}

model Proposal {
  id         String         @id @default(cuid())
  number     String         @unique
  customerId String
  title      String
  summary    String?        @db.Text
  status     ProposalStatus @default(DRAFT)
  issueDate  DateTime       @default(now())
  validUntil DateTime?
  taxRate    Decimal        @default(0) @db.Decimal(5, 2)
  terms      String?        @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Sharing — the token is the client's only credential, so it is issued when the
  // proposal is sent and cleared when it goes back to draft.
  shareToken      String?   @unique
  sentAt          DateTime?
  respondedAt     DateTime?
  respondedByName String?
  declineNote     String?   @db.Text

  // Conversion — an accepted proposal becomes the project it was quoting for.
  // Unique, so a proposal is only ever won once; clearing the project (if it is
  // deleted) leaves the proposal itself intact as a record of the quote.
  projectId   String?   @unique
  convertedAt DateTime?

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items    ProposalItem[]
  invoices Invoice[]

  @@index([customerId])
  @@index([status])
}

model ProposalItem {
  id          String  @id @default(cuid())
  proposalId  String
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  position    Int     @default(0)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

/**
 * What happened with an account, and what is owed back. Everything hangs off the
 * customer; the contact and project are optional narrowing, and they null out on
 * delete rather than taking the history with them.
 */
model Activity {
  id         String       @id @default(cuid())
  customerId String
  contactId  String?
  projectId  String?
  userId     String?
  type       ActivityType @default(NOTE)
  subject    String
  body       String?      @db.Text
  occurredAt DateTime     @default(now())
  // A follow-up is just an activity that points at a future date until it is done.
  followUpAt     DateTime?
  followUpDoneAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([contactId])
  @@index([projectId])
  @@index([followUpAt])
}

/**
 * A standing arrangement that produces invoices — a retainer, a hosting fee.
 * It holds its own copy of the line items rather than pointing at the invoice it
 * was created from: editing or deleting last month's invoice must not silently
 * change what gets billed next month.
 */
model RecurringInvoice {
  id         String    @id @default(cuid())
  customerId String
  title      String
  taxRate    Decimal   @default(0) @db.Decimal(5, 2)
  notes      String?   @db.Text
  terms      String?   @db.Text
  cadence    Cadence   @default(MONTHLY)
  // How long the generated invoice gets to be paid, counted from its issue date.
  dueInDays  Int       @default(30)
  nextRunOn  DateTime
  lastRunOn  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer  Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items     RecurringInvoiceItem[]
  generated Invoice[]

  @@index([customerId])
  @@index([isActive, nextRunOn])
}

model RecurringInvoiceItem {
  id                 String  @id @default(cuid())
  recurringInvoiceId String
  description        String
  quantity           Decimal @default(1) @db.Decimal(10, 2)
  unitPrice          Decimal @default(0) @db.Decimal(12, 2)
  position           Int     @default(0)

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)

  @@index([recurringInvoiceId])
}

/**
 * What a job cost you. Attached to a project where there is one, because the
 * question worth answering is per-project margin; a customer-level expense with
 * no project is still allowed, since not everything you spend maps to a job.
 *
 * `billable` records intent to recharge, not the fact of it — an expense stays
 * on the books whether or not it ends up on an invoice.
 */
model Expense {
  id          String          @id @default(cuid())
  projectId   String?
  customerId  String?
  description String
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory @default(OTHER)
  billable    Boolean         @default(false)
  incurredAt  DateTime        @default(now())
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([customerId])
  @@index([incurredAt])
}

model Invoice {
  id                 String @id @default(cuid())
  number             String @unique
  customerId         String
  // Set when this invoice was produced by a standing arrangement.
  recurringInvoiceId String?
  // Where the invoice came from. Both are optional and nullable on delete: billing
  // history outlives the project or quote it was raised against.
  projectId  String?
  proposalId String?
  title      String
  status     InvoiceStatus @default(DRAFT)
  issueDate  DateTime      @default(now())
  dueDate    DateTime?
  taxRate    Decimal       @default(0) @db.Decimal(5, 2)
  notes      String?       @db.Text
  terms      String?       @db.Text
  sentAt     DateTime?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  proposal         Proposal?         @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  recurringInvoice RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  items            InvoiceItem[]
  payments         Payment[]

  @@index([customerId])
  @@index([projectId])
  @@index([proposalId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  position    Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id         String        @id @default(cuid())
  invoiceId  String
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod @default(BANK_TRANSFER)
  reference  String?
  receivedAt DateTime      @default(now())
  note       String?       @db.Text
  createdAt  DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model ProjectTask {
  id        String   @id @default(cuid())
  projectId String
  title     String
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
